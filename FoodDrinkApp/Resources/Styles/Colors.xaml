<?xml version="1.0" encoding="UTF-8" ?>
<?xaml-comp compile="true" ?>
<ResourceDictionary 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <Color x:Key="Primary">#0F172A</Color>
    <Color x:Key="Accent">#F97316</Color>
    <Color x:Key="Secondary">#64748B</Color>

    <Color x:Key="LightBgStart">#FFF7ED</Color>
    <Color x:Key="LightBgEnd">#FFFFFF</Color>

    <Color x:Key="DarkBgStart">#020617</Color>
    <Color x:Key="DarkBgEnd">#0F172A</Color>

    <Color x:Key="SuccessGreen">#22C55E</Color>
    <Color x:Key="ErrorRed">#EF4444</Color>
    <Color x:Key="White">#FFFFFF</Color>
    <Color x:Key="Black">#000000</Color>
</ResourceDictionary>